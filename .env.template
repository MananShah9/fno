# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=your_phone_number_with_country_code

# Telegram Channels (can be channel username like @channel_name or absolute integer ID)
TELEGRAM_SOURCE_CHANNEL=
TELEGRAM_MIRROR_CHANNEL=
TELEGRAM_ACTIONS_CHANNEL=

# Telegram refresh / polling interval in seconds
TELEGRAM_REFRESH_INTERVAL=10

# Telegram Message Schedule & Time Restrictions
# Set TELEGRAM_TIME_FILTER_ENABLED=true to restrict automated order placement to market hours on weekdays
# (All incoming messages are ingested and analysed by AI 24/7; pre-market orders are held in READY_FOR_MARKET_OPEN queue)
TELEGRAM_TIME_FILTER_ENABLED=true
TELEGRAM_START_TIME=08:30
TELEGRAM_END_TIME=16:00
TELEGRAM_WEEKDAYS_ONLY=true
TELEGRAM_TIMEZONE=Asia/Kolkata

# Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash

# Database Settings
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_pass
DB_NAME=fno_db

# Zerodha Credentials & Proxy Settings
ZERODHA_API_KEY=your_api_key
ZERODHA_API_SECRET=your_api_secret
ZERODHA_USER_ID=your_user_id
ZERODHA_PASSWORD=your_password
ZERODHA_EXTERNAL_2FA_TOTP=your_totp_secret
ZERODHA_PROXY_URL=http://100.125.89.97:8888
AUTO_PLACE_ORDERS=false
AUTO_PLACE_EXIT_ORDERS=false

# Target investment budget in INR (e.g. 100000 for 1 Lakh).
# Used for position sizing based on premium for option buying, and margin for spreads/short options/futures.
TARGET_INVESTMENT_BUDGET=100000

# Risk Management: Strict Maximum Lot Caps per Trade
MAX_STOCK_LOTS=2
MAX_INDEX_LOTS=4

# Trade Adjustment & Averaging Lifecycle State Machine
# MAX_ADJUSTMENTS_PER_TRADE: Max number of allowed averaging/adjustment occurrences per trade (e.g. 1)
# ADJUSTMENT_DEDUPLICATION_WINDOW_MINUTES: Rolling window in minutes during which repeated mentions/discussions of averaging are deduplicated
# ADJUSTMENT_MAX_LOTS: Max lots allocated for an averaging adjustment (default 1) to prevent position bloating
MAX_ADJUSTMENTS_PER_TRADE=1
ADJUSTMENT_DEDUPLICATION_WINDOW_MINUTES=30
ADJUSTMENT_MAX_LOTS=1

# Estimated Margin Tiers in INR per Lot (Fallbacks when Zerodha Margin API is offline)
ESTIMATED_INDEX_SPREAD_MARGIN=40000
ESTIMATED_STOCK_SPREAD_MARGIN=120000
ESTIMATED_INDEX_FUTURES_MARGIN=130000
ESTIMATED_STOCK_FUTURES_MARGIN=200000
ESTIMATED_INDEX_SHORT_OPTION_MARGIN=130000
ESTIMATED_STOCK_SHORT_OPTION_MARGIN=200000

# Exchange Freeze Quantity Limits (NSE / BSE F&O)
# Automated iceberg order slicing triggers when order quantity exceeds these limits.
FREEZE_LIMIT_NIFTY=1800
FREEZE_LIMIT_BANKNIFTY=900
FREEZE_LIMIT_FINNIFTY=1800
FREEZE_LIMIT_MIDCPNIFTY=4200
DEFAULT_STOCK_FREEZE_LOT_MULTIPLIER=20

# Logging Level (e.g. DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

